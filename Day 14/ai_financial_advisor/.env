# ============================================================
# AI Financial Advisor - Environment Configuration
# Copy this file to .env and fill in your credentials
# ============================================================

# OpenAI API Key (required)
OPENAI_API_KEY=


# OpenAI Model Configuration
OPENAI_MODEL=gpt-4o-mini          # Cost-efficient default; swap to gpt-4o for max quality
OPENAI_TEMPERATURE=0.2             # Low for deterministic financial advice

# Application Settings
APP_ENV=development                # development | production
APP_PORT=8000
STREAMLIT_PORT=8501
LOG_LEVEL=INFO

# CrewAI Configuration
CREWAI_TELEMETRY=false             # Disable telemetry for privacy

# FastAPI Settings
API_TITLE=AI Financial Advisor API
API_VERSION=1.0.0
